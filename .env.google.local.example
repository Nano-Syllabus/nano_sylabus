# Copy to .env.google.local (gitignored); keep all secrets server-side.
# Google Auth Platform -> Clients -> Web application OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Supabase Management API token with Auth configuration read/write permissions
# limited to staging. This is neither a publishable key nor a service-role key.
SUPABASE_ACCESS_TOKEN=
# Replace these with the actual staging origin when deploying staging.
GOOGLE_AUTH_SITE_URL=http://localhost:3001
GOOGLE_AUTH_REDIRECT_URLS=http://localhost:3001/auth/callback,http://127.0.0.1:3001/auth/callback
