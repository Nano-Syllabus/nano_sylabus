# Sweep the global challenge pool every ~30 seconds.
# Install notes: scripts/ops/challenge-pool-sweep.sh. Not installed by this repo.
[Unit]
Description=Sweep the Nano Syllabus challenge pool every 30 seconds

[Timer]
OnBootSec=15s
OnUnitInactiveSec=30s
AccuracySec=1s
RandomizedDelaySec=3s
Unit=challenge-pool-sweep.service

[Install]
WantedBy=timers.target
