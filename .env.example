NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_ENV=development
# These must refer to different databases. The selected URL above must match
# the corresponding environment; startup helpers load separate private files.
NEXT_PUBLIC_DEVELOPMENT_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_STAGING_SUPABASE_URL=
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
# OAuth returns to the origin where sign-in started, at /auth/callback.
SUPABASE_SERVICE_ROLE_KEY=

# Keep these stable when moving Supabase projects or rotating the service key.
# Existing MCQ answers and explanations depend on CHALLENGE_ANSWER_SECRET;
# the VPS challenge timer must use the same CHALLENGE_POOL_SWEEP_SECRET.
# If unset, both are derived from SUPABASE_SERVICE_ROLE_KEY.
CHALLENGE_ANSWER_SECRET=
CHALLENGE_POOL_SWEEP_SECRET=

# Tenant API. Content is teacher-managed, so this is the teachers-app tenant
# key (tenant_sk_live_teachers_app_...). It scopes chat, the subject catalog,
# and the practice API.
TENANT_API_BASE_URL=
TENANT_API_TOKEN=

# Operator key for /v1/teacher-app/* (onboard, list, rotate, offboard).
# Same teachers-app tenant key as above.
TEACHER_APP_API_TOKEN=

# The tenant API is served over a self-signed certificate — keep this 0 unless
# it moves behind a trusted cert.
TENANT_API_REJECT_UNAUTHORIZED=0
TENANT_API_TIMEOUT_MS=30000

# Binary-object storage on the VPS. All three default to the tenant API URL and
# token, so set these only when storage has a separate host or credential.
VPS_STORAGE_URL=
VPS_STORAGE_TOKEN=
VPS_STORAGE_SIGNING_SECRET=
# Optional internal origin used by the same-origin /vps-storage rewrite.
VPS_STORAGE_PROXY_ORIGIN=
# Development uses "development"; staging keeps this empty for existing files.
VPS_STORAGE_PATH_PREFIX=development

# Optional. A Google Cloud API key with the Drive API enabled, used to import a
# document a creator has shared as "Anyone with the link". It is an API key and
# not OAuth on purpose: reading a PRIVATE Drive needs the drive.readonly scope,
# which Google classes as restricted and gates behind a security assessment.
#
# Without it, a creator can still paste a link to a single shared FILE, and a
# Google Doc/Slides/Sheet link is still converted to PDF/CSV on the way in --
# the editor URL says which it is, so no metadata call is needed.
#
# With it they also get FOLDER links (every document inside is imported), plus
# real filenames, sizes and type checks BEFORE anything is fetched rather than
# once the bytes have already arrived.
GOOGLE_DRIVE_API_KEY=

# ── local dev only ───────────────────────────────────────────────────────────
# Challenges authenticate as the creator, with `teachers.collection_sk` out of
# Supabase. Supabase is production even when TENANT_API_BASE_URL is localhost, so
# a local api-service rejects that key with 401 "invalid tenant API key". Set this
# to a key the LOCAL backend knows (see its NSDI_CLIENTS_JSON) to run challenges
# locally. Ignored on Vercel and in production builds.
# DEV_COLLECTION_KEY=nsdi_dev_teachers_app

# Who may press "Restart challenge" on a graded attempt. Comma-separated, and
# empty means nobody — a restart re-issues the lesson and the paper, so it costs
# a model call and hands out a second attempt at a topic already scored.
# Server-only on purpose: the challenges page resolves it to a boolean before it
# reaches the browser, so no address is inlined into the bundle.
CHALLENGE_REFETCH_EMAILS=surfwithprashant@gmail.com

# Independent document queue recovery (scripts/ops/indexing-sweep.timer).
# Generate a random secret and set the same value in the timer environment.
# POST /api/internal/indexing/sweep with Authorization: Bearer <secret> every minute.
INDEXING_SWEEP_SECRET=
